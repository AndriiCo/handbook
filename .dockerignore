# Docker build contexts never see secrets, local stores or build output.
private/
.local/
target/
web/node_modules/
web/build/
web/build-admin/
web/shots/
.git/
.claude/
.muse/
# Crawl drops (large) and operator-licensed brand files: never in an image.
archive/
web/static/fonts/brand/
web/src/lib/assets/brand/*.svg
