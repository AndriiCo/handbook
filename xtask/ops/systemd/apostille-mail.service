# apostille-mail.service
#
# One-shot Gmail poll: new mailbox mail becomes immutable `email`
# captures with auth evidence. Triggered by apostille-mail.timer
# every 15 minutes.
#
# Install: `cargo xtask setup` stages every unit under units/ and
# `xtask provision` writes them to /etc/systemd/system, enabling the
# timers the setup file's target names (`mail`).
# Requires the Gmail OAuth client + refresh token in sealed config
# (docs/gmail-shapes.md), or every run exits 2.
#
# Privilege summary: runs as andrii-ai:andrii-ai, no capabilities,
# reads the KEK credential (sealed Gmail secrets), one writable dir.
[Unit]
Description=Apostille Handbook Gmail poll (mail into captures)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=andrii-ai
Group=andrii-ai
ExecStart=/srv/apostille/current/xtask mail-poll --store /var/lib/apostille --actor timer
# No Environment=STORE_DIR: xtask takes --store explicitly (F1).
LoadCredential=handbook-kek:/etc/apostille/handbook-kek
StateDirectory=apostille
WorkingDirectory=/var/lib/apostille
UMask=0027

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/apostille
# Outbound HTTPS (Google APIs) + loopback only.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
