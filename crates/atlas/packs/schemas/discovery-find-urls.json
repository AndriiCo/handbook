{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DiscoveryFindUrls",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "unknown", "urls"],
        "properties": {
          "slug": {"type": "string"},
          "unknown": {"type": "boolean"},
          "urls": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["url", "kind"],
              "properties": {
                "url": {"type": "string"},
                "kind": {
                  "type": "string",
                  "enum": ["apostille_page", "authority_home", "form", "fees", "other"]
                },
                "language": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
