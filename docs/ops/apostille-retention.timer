# apostille-retention.timer — PROPOSED (no enable decision yet;
# enable together with apostille-retention.service once decided).
#
# Daily sweep with a random delay so it never aligns with the watch
# and backup runs into a burst. Persistent: a missed run (downtime)
# fires once at the next boot instead of silently skipping a day.
[Unit]
Description=Daily Apostille Handbook retention sweep

[Timer]
OnCalendar=daily
RandomizedDelaySec=1800
Persistent=true
Unit=apostille-retention.service

[Install]
WantedBy=timers.target
