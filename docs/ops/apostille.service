# apostille.service — LIVE since 2026-10-27 (reviewed prompt 015,
# installed by the author, verified serving).
#
# Install (as root, once): copy to /etc/systemd/system/apostille.service,
# `systemctl daemon-reload && systemctl enable --now apostille`.
# Ships via `xtask deploy` as hal (runbook-release.md); the
# /usr/local/sbin/apostille-ship script stays as reviewed fallback.
#
# Privilege summary: runs as andrii-ai:andrii-ai, keeps ONLY
# CAP_NET_BIND_SERVICE (to bind 80/443), cannot gain more
# (NoNewPrivileges), sees almost no filesystem (ProtectSystem=strict
# + ReadWritePaths), no home, no tmp sharing, no new namespaces,
# native syscalls only.
[Unit]
Description=Apostille Handbook API (andrii.ai/apostille)
After=network-online.target
Wants=network-online.target
# Crash-loop guard (2026-10-27 ACME incident: a boot-time issuance
# failure restarted into Google ~60x before anyone stopped it,
# burning failed-validation rate limits): after 5 failures in 10
# minutes the unit stays down for operator eyes instead of
# hammering the CA. Reset with `systemctl reset-failed apostille`.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=andrii-ai
Group=andrii-ai
ExecStart=/srv/apostille/current/web
# Zero-env (config-db.md): STORE_DIR is the only setting left here —
# it locates the DB. Binds, ports, hosts, TLS paths, ACME, and all
# other settings live in sealed DB rows (set via `xtask config-set`
# before first boot; migration map in config-db.md §5). Never add
# runtime settings back as Environment= lines.
# Explicit IPs (now DB keys net.bind/net.bind6): never 0.0.0.0 —
# sibling services own :80/:443 on other addresses of this box.
Environment=STORE_DIR=/var/lib/apostille
# KEK credential (REQUIRED — release refuses KEK-less boot):
# root-owned 0600 source, exposed to the service at
# $CREDENTIALS_DIRECTORY/handbook-kek. Enrolled via
# `xtask config-enroll --kek-file /etc/apostille/handbook-kek`
# (see the prod cutover notes); TPM-sealed upgrade later.
LoadCredential=handbook-kek:/etc/apostille/handbook-kek
# State dir auto-created and chowned to andrii-ai on first start.
StateDirectory=apostille
StateDirectoryMode=0750
WorkingDirectory=/var/lib/apostille
UMask=0027
Restart=on-failure
RestartSec=5s
# Panic=abort binary: any Rust panic kills the process; systemd
# restarts it into a clean state (fail-closed, no unwound half-state).

# --- Capabilities: bind low ports, nothing else. ---
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# --- Filesystem: read-only world, one writable dir. ---
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/var/lib/apostille

# --- Network/namespaces/misc: smallest working set. ---
# AF_UNIX (logging/NSS) + v4/v6: outbound HTTPS to the ACME
# directory (Google Public CA) is required for issuance/renewal;
# Meta/carrier/Stripe clients land later and need no sandbox change.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

# --- STAGE-GATED (do NOT enable before a staging soak). ---
# Too easy to brick an untested service; each needs a proven-good
# staging run with the exact production traffic shape first:
# SystemCallFilter=@system-service  (unlisted syscall = SIGSYS kill)
# MemoryDenyWriteExecute=true       (no JIT in our stack, but verify)

[Install]
WantedBy=multi-user.target
