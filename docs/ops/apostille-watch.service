# apostille-watch.service — APPROVED (prompt 054, D41: enable on prod
# once the deploy train ships the matching xtask).
# F1 re-check (prompt 083): --store added (xtask never reads
# STORE_DIR); flags re-verified against xtask usage. Still APPROVED.
#
# One-shot watch sweep: poll due watch URLs (conditional GET, ingest
# only changes), then poll the HCCH status table (task on change).
# Triggered by apostille-watch.timer, daily.
#
# Install (as root, once): copy this file + apostille-watch.timer to
# /etc/systemd/system/, `systemctl daemon-reload && systemctl enable
# --now apostille-watch.timer`.
#
# Privilege summary: runs as andrii-ai:andrii-ai, no capabilities
# (no low ports), no secrets (fetches are unauthenticated —
# deliberately no LoadCredential here), one writable dir.
[Unit]
Description=Apostille Handbook watch sweep (due URLs + HCCH poll)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=andrii-ai
Group=andrii-ai
# Sequential: the HCCH poll runs only if the sweep exits 0 (a failed
# sweep usually means DB trouble the poll would hit too).
ExecStart=/srv/apostille/current/xtask watch-sweep --store /var/lib/apostille --actor timer
ExecStart=/srv/apostille/current/xtask hcch-poll --store /var/lib/apostille --actor timer
# No Environment=STORE_DIR: xtask takes --store explicitly (F1).
StateDirectory=apostille
WorkingDirectory=/var/lib/apostille
UMask=0027

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/apostille
# Outbound HTTPS (fetches) + loopback only.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
