# apostille-instruct.service — PROVISIONED (TODO E-3: `cargo xtask
# setup` enables it with the other production timers; the setup
# template lists `instruct` in targets.production.timers).
# F1/F2 re-check (prompt 083): --store added (xtask never reads
# STORE_DIR); --pack repointed at the shipped packs/ dir (releases
# never stage crates/).
#
# One-shot instruction sweep: new email / comment / transcript
# captures become instruction drafts + proposed fact updates with
# before/after reasons. Proposals only — humans decide via the
# review queue. Triggered by apostille-instruct.timer every
# 5 minutes.
#
# Install: every release stages this file and apostille-instruct.timer
# under units/, and `xtask provision` copies them to /etc/systemd/system
# and runs `systemctl enable --now apostille-instruct.timer` when the
# target's timers name `instruct`. Requires the Meta API key in sealed
# config first, or every live run exits 2.
#
# Privilege summary: runs as andrii-ai:andrii-ai, no capabilities,
# reads the KEK credential (sealed Meta key), one writable dir.
[Unit]
Description=Apostille instruction worker sweep (triggers to proposals)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=andrii-ai
Group=andrii-ai
ExecStart=/srv/apostille/current/xtask instruct-sweep --live --store /var/lib/apostille --pack /srv/apostille/current/packs/general.toml --actor timer
# No Environment=STORE_DIR: xtask takes --store explicitly (F1).
LoadCredential=handbook-kek:/etc/apostille/handbook-kek
StateDirectory=apostille
WorkingDirectory=/var/lib/apostille
UMask=0027

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/apostille
# Outbound HTTPS (Meta Model API) + loopback only.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
