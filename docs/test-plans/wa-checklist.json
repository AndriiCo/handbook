{
  "version": 1,
  "authority": "usa-wa-sos",
  "about": "Washington value checklist for the apostille guide: every value a customer needs, one per row of the WA data readiness review (2026-11-04 01:50 UTC, 74 rows), with the slot it fills, the official page that prints it, and whether the us_state profile treats it as critical. web/scripts/dossier-metrics.mjs measures coverage against it.",
  "fields": {
    "id": "stable value id",
    "section": "where the value renders: status, before, prepare, form, fees, send-mail, send-courier, visit, after, contact",
    "label": "what the value is, for people reading this file (never page copy)",
    "slot": "slots.json id, {topic}.{name}; null when the value is not a fact (see plan and computed_from)",
    "instance": "the office (or date) a value belongs to, written after __ in the statement key",
    "key": "the statement key to give the fact at accept: field[__instance]",
    "source": "alias (see sources) of the official page that prints the value today; for an absent value, the page that is silent",
    "also": "other official pages that print it",
    "critical": "the us_state profile's critical slots, one value each; a critical value whose facts conflict counts as covered only after a staff decision",
    "vocabulary": "false when the slot is outside the plan's section 9.3 vocabulary and slots.json v1: the page lists the fact under 'Also on the office's pages', and metrics match it by the {topic}.{key} convention",
    "match.source": "the covering fact must cite this page",
    "computed_from": "the page computes this value from those values; covered when they are",
    "plan": "a /plan field (dotted path) holding staff-accepted data (an accepted form map) that also covers the value; never the authority row",
    "shown": "a /plan authority-row field (pack data, no citation): the page shows it, but it never counts as covered; metrics list it as shown, not cited",
    "unscoped_ok": "a fact with no instance (one rule for both offices) also covers this instance",
    "absent": "the office does not print it; only a stated absence or the office's written answer can fill it",
    "confirm": "the call or email question that settles it: its priority (P1-P3) in the readiness review, or 'call'"
  },
  "targets": {
    "covered": 40,
    "critical": 5,
    "false_conflicts": 0,
    "closures": 6,
    "newest_capture_hours": 24
  },
  "critical_slots": ["fees.per_document", "payment.payee", "mailing.usps", "processing_time.standard", "forms.form"],
