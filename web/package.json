{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:admin": "WEB_BUILD=admin vite dev",
		"build": "vite build",
		"build:admin": "WEB_BUILD=admin vite build",
		"prebuild": "node scripts/brand-fonts.mjs",
		"prebuild:admin": "node scripts/brand-fonts.mjs",
		"preview": "vite preview",
		"prepare": "WEB_BUILD=admin svelte-kit sync || echo ''",
		"check": "WEB_BUILD=admin svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "WEB_BUILD=admin svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:imports": "node scripts/check-imports.mjs",
		"check:tailwind": "node scripts/check-tailwind.mjs",
		"smoke": "node scripts/smoke.mjs",
		"test": "node --test \"test/**/*.test.mjs\"",
		"test:e2e": "playwright test",
		"demo": "playwright test e2e/demo.spec.mjs",
		"shots": "node scripts/shots.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/public-sans": "^5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.1",
		"@lucide/svelte": "^1.64.0",
		"@tailwindcss/typography": "^0.5.20",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"d3-geo": "^3.1.1",
		"flag-icons": "^7.6.0",
		"svelte-sonner": "^1.2.2",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "3.3.1",
		"topojson-client": "^3.1.0",
		"tw-animate-css": "^1.4.0",
