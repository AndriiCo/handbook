{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"resolveJsonModule": true,
		"paths": {
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "vite.config.ts"],
	"exclude": ["node_modules", "src/routes-public", "build", "build-admin", ".svelte-kit"]
}
